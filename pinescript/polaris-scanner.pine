//@version=6
indicator("Polaris Scanner — Sweep / CISD / FVG", overlay=true, max_lines_count=100, max_boxes_count=100, max_labels_count=200)

// ============================================================================
// Polaris Scanner (Pine port)
// Same model as Polaris's JS scanner (advanceScan/findSwings/fvgAt in
// index.html): liquidity sweep -> change in state of delivery (CISD) ->
// retrace into the resulting fair value gap -> rejection. On a completed
// setup, fires a webhook alert shaped for the Polaris receiveAlert Cloud
// Function (see functions/index.js).
//
// Entry/stop/target/confidence are NOT part of the original JS scanner
// model (it only annotates structure, no trade parameters) -- these are
// invented here specifically for the webhook payload:
//   stop       = swept level +/- an optional buffer
//   target     = entry +/- risk * rMultiple
//   confidence = FVG size relative to ATR(14), a rough heuristic only
// Adjust the inputs below, or the fvgConfidence() formula, to taste.
// ============================================================================

// ---------- inputs ----------
grpScan = "Scanner"
swingStrength = input.int(3, "Swing strength (bars each side)", minval=1, maxval=10, group=grpScan)
maxBarsValid  = input.int(40, "Max bars before a sequence expires", minval=5, group=grpScan)
maxSwings     = input.int(20, "Max recent swings tracked per side", minval=5, maxval=50, group=grpScan)
showVisuals   = input.bool(true, "Show sweep/FVG markup on chart", group=grpScan)

grpTrade = "Trade parameters (for the webhook payload only)"
stopBufferPts = input.float(0.0, "Stop buffer beyond swept level (points)", minval=0, group=grpTrade)
rMultiple     = input.float(2.0, "Target = entry +/- risk x this", minval=0.1, group=grpTrade)

grpHook = "Webhook"
webhookSecret = input.string("", "Webhook secret (must match WEBHOOK_SECRET)", group=grpHook)

// ---------- types ----------
type Swing
    int   idx
    float price

// ---------- persistent state ----------
var array<Swing> swingHighs = array.new<Swing>()
var array<Swing> swingLows  = array.new<Swing>()

var string seqDir        = na   // "bull" | "bear"
var string seqPhase      = na   // "sweep" | "cisd" | "retrace"
var float  seqLevel      = na
var float  seqCisdTarget = na
var int    seqSweepBar   = na
var bool   seqHasFvg     = false
var float  seqFvgLo      = na
var float  seqFvgHi      = na

// ---------- swing detection (mirrors findSwings) ----------
ph = ta.pivothigh(swingStrength, swingStrength)
pl = ta.pivotlow(swingStrength, swingStrength)

if not na(ph)
    array.unshift(swingHighs, Swing.new(bar_index - swingStrength, ph))
    if array.size(swingHighs) > maxSwings
        array.pop(swingHighs)

if not na(pl)
    array.unshift(swingLows, Swing.new(bar_index - swingStrength, pl))
    if array.size(swingLows) > maxSwings
        array.pop(swingLows)

// ---------- helpers ----------
// mirrors cisdTargetBear/Bull(cs, idx) -- only ever called at idx == current
// bar (offset 0), i.e. right when a sweep is first detected this bar.
cisdTargetBear() =>
    int j = 0
    if close[j] <= open[j]
        j := j + 1
    int start = -1
    while j <= 200 and close[j] > open[j]
        start := j
        j := j + 1
    start >= 0 ? open[start] : low[0]

cisdTargetBull() =>
    int j = 0
    if close[j] >= open[j]
        j := j + 1
    int start = -1
    while j <= 200 and close[j] < open[j]
        start := j
        j := j + 1
    start >= 0 ? open[start] : high[0]

// mirrors fvgAt(cs, k, dir) -- off is bars back from current bar for candle "k"
fvgAtBear(int off) =>
    bool has = low[off + 2] > high[off]
    [has, has ? high[off] : na, has ? low[off + 2] : na]

fvgAtBull(int off) =>
    bool has = high[off + 2] < low[off]
    [has, has ? high[off + 2] : na, has ? low[off] : na]

// atrVal must be computed unconditionally every bar (see call site below) --
// ta.* calls inside a function that's only invoked conditionally trip
// Pine's CW10003 warning, since ta.atr()'s internal history tracking needs
// consistent per-bar evaluation. Passing it in as a plain value avoids that.
atrVal = ta.atr(14)

// heuristic only, not predictive -- bigger FVG relative to recent volatility
// scores higher, clamped to [30, 95]
fvgConfidence(float fvgLo, float fvgHi, float atr) =>
    float size = fvgHi - fvgLo
    float ratio = atr > 0 ? size / atr : 0
    int conf = math.round(math.min(95, 40 + ratio * 40))
    math.max(conf, 30)

// ---------- webhook payload builder ----------
buildAlertMessage(string setupType, float entryPrice, float stopPrice, float targetPrice, int confidence) =>
    float risk = math.abs(entryPrice - stopPrice)
    float reward = math.abs(targetPrice - entryPrice)
    float rr = risk > 0 ? math.round((reward / risk) * 100) / 100 : na
    '{"secret":"' + webhookSecret + '","setupType":"' + setupType + '","entryPrice":' + str.tostring(entryPrice) +
     ',"stopPrice":' + str.tostring(stopPrice) + ',"targetPrice":' + str.tostring(targetPrice) +
     ',"confidence":' + str.tostring(confidence) + ',"riskReward":' + str.tostring(rr) +
     ',"symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '"}'

// ---------- main scan (mirrors advanceScan), only on confirmed/closed bars ----------
if barstate.isconfirmed
    if na(seqDir)
        // look for a swept high (bearish setup) -- best (highest) prior swing that got wicked through and closed back under
        float bestHigh = na
        if array.size(swingHighs) > 0
            for i = 0 to array.size(swingHighs) - 1
                Swing s = array.get(swingHighs, i)
                if high > s.price and close < s.price
                    if na(bestHigh) or s.price > bestHigh
                        bestHigh := s.price

        if not na(bestHigh)
            seqDir := "bear"
            seqPhase := "sweep"
            seqLevel := bestHigh
            seqCisdTarget := cisdTargetBear()
            seqSweepBar := bar_index
            seqHasFvg := false
            if showVisuals
                label.new(bar_index, high, "SWEEP", style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.tiny)

        if na(seqDir) and array.size(swingLows) > 0
            float bestLow = na
            for i = 0 to array.size(swingLows) - 1
                Swing s = array.get(swingLows, i)
                if low < s.price and close > s.price
                    if na(bestLow) or s.price < bestLow
                        bestLow := s.price
            if not na(bestLow)
                seqDir := "bull"
                seqPhase := "sweep"
                seqLevel := bestLow
                seqCisdTarget := cisdTargetBull()
                seqSweepBar := bar_index
                seqHasFvg := false
                if showVisuals
                    label.new(bar_index, low, "SWEEP", style=label.style_label_up, color=color.blue, textcolor=color.white, size=size.tiny)

    else
        if bar_index - seqSweepBar > maxBarsValid
            seqDir := na
            seqPhase := na
        else if seqDir == "bear"
            if seqPhase == "sweep"
                if close > seqLevel
                    seqDir := na
                    seqPhase := na
                else if close < seqCisdTarget
                    int barsSince = bar_index - seqSweepBar
                    bool found = false
                    float fLo = na
                    float fHi = na
                    for off = 0 to math.min(barsSince - 1, 200)
                        if not found
                            [has, lo, hi] = fvgAtBear(off)
                            if has
                                found := true
                                fLo := lo
                                fHi := hi
                    seqPhase := "cisd"
                    seqHasFvg := found
                    seqFvgLo := fLo
                    seqFvgHi := fHi
            else if seqPhase == "cisd"
                if not seqHasFvg
                    [has, lo, hi] = fvgAtBear(0)
                    if has
                        seqHasFvg := true
                        seqFvgLo := lo
                        seqFvgHi := hi
                    else if close > seqLevel
                        seqDir := na
                        seqPhase := na
                if seqHasFvg and not na(seqDir)
                    if close > seqFvgHi
                        seqDir := na
                        seqPhase := na
                    else if high >= seqFvgLo
                        if close < seqFvgLo
                            int conf = fvgConfidence(seqFvgLo, seqFvgHi, atrVal)
                            float entryP = close
                            float stopP = seqLevel + stopBufferPts
                            float targetP = entryP - math.abs(entryP - stopP) * rMultiple
                            alert(buildAlertMessage("CHoCH_DOWN", entryP, stopP, targetP, conf), alert.freq_once_per_bar_close)
                            if showVisuals
                                label.new(bar_index, low, "SETUP\nCOMPLETE", style=label.style_label_up, color=color.red, textcolor=color.white, size=size.small)
                            seqDir := na
                            seqPhase := na
                        else
                            seqPhase := "retrace"
            else if seqPhase == "retrace"
                if close > seqFvgHi
                    seqDir := na
                    seqPhase := na
                else if close < seqFvgLo
                    int conf = fvgConfidence(seqFvgLo, seqFvgHi, atrVal)
                    float entryP = close
                    float stopP = seqLevel + stopBufferPts
                    float targetP = entryP - math.abs(entryP - stopP) * rMultiple
                    alert(buildAlertMessage("CHoCH_DOWN", entryP, stopP, targetP, conf), alert.freq_once_per_bar_close)
                    if showVisuals
                        label.new(bar_index, low, "SETUP\nCOMPLETE", style=label.style_label_up, color=color.red, textcolor=color.white, size=size.small)
                    seqDir := na
                    seqPhase := na
        else if seqDir == "bull"
            if seqPhase == "sweep"
                if close < seqLevel
                    seqDir := na
                    seqPhase := na
                else if close > seqCisdTarget
                    int barsSince = bar_index - seqSweepBar
                    bool found = false
                    float fLo = na
                    float fHi = na
                    for off = 0 to math.min(barsSince - 1, 200)
                        if not found
                            [has, lo, hi] = fvgAtBull(off)
                            if has
                                found := true
                                fLo := lo
                                fHi := hi
                    seqPhase := "cisd"
                    seqHasFvg := found
                    seqFvgLo := fLo
                    seqFvgHi := fHi
            else if seqPhase == "cisd"
                if not seqHasFvg
                    [has, lo, hi] = fvgAtBull(0)
                    if has
                        seqHasFvg := true
                        seqFvgLo := lo
                        seqFvgHi := hi
                    else if close < seqLevel
                        seqDir := na
                        seqPhase := na
                if seqHasFvg and not na(seqDir)
                    if close < seqFvgLo
                        seqDir := na
                        seqPhase := na
                    else if low <= seqFvgHi
                        if close > seqFvgHi
                            int conf = fvgConfidence(seqFvgLo, seqFvgHi, atrVal)
                            float entryP = close
                            float stopP = seqLevel - stopBufferPts
                            float targetP = entryP + math.abs(entryP - stopP) * rMultiple
                            alert(buildAlertMessage("CHoCH_UP", entryP, stopP, targetP, conf), alert.freq_once_per_bar_close)
                            if showVisuals
                                label.new(bar_index, high, "SETUP\nCOMPLETE", style=label.style_label_down, color=color.green, textcolor=color.white, size=size.small)
                            seqDir := na
                            seqPhase := na
                        else
                            seqPhase := "retrace"
            else if seqPhase == "retrace"
                if close < seqFvgLo
                    seqDir := na
                    seqPhase := na
                else if close > seqFvgHi
                    int conf = fvgConfidence(seqFvgLo, seqFvgHi, atrVal)
                    float entryP = close
                    float stopP = seqLevel - stopBufferPts
                    float targetP = entryP + math.abs(entryP - stopP) * rMultiple
                    alert(buildAlertMessage("CHoCH_UP", entryP, stopP, targetP, conf), alert.freq_once_per_bar_close)
                    if showVisuals
                        label.new(bar_index, high, "SETUP\nCOMPLETE", style=label.style_label_down, color=color.green, textcolor=color.white, size=size.small)
                    seqDir := na
                    seqPhase := na

// ---------- FVG box visualization while a sequence is active ----------
if showVisuals and seqHasFvg and not na(seqFvgLo)
    box.new(seqSweepBar, seqFvgLo, bar_index, seqFvgHi, border_color=color.new(color.purple, 40), bgcolor=color.new(color.purple, 85))
