//@version=6
indicator("Polaris Scanner — Liquidity & Structure Map", overlay=true, max_lines_count=200, max_boxes_count=150, max_labels_count=250)

// ============================================================================
// Polaris Scanner — a confluence map, not a signal generator
// ============================================================================
// This indicator used to run a sweep -> CISD -> FVG-retrace -> rejection
// state machine that fired webhook alerts with computed entry/stop/target,
// tracked a win-rate scorecard, and mirrored every fire/resolution into the
// Polaris dashboard (functions/index.js, index.html's old ALERTS/INDICATOR
// tabs, Twilio SMS/voice calls). All of that is gone as of this rewrite.
// After trading off those alerts for a while, the conclusion was that
// discretion beats acting on auto-fired signals -- so this goes back to
// doing what the original JS scanner in index.html was actually good at:
// marking liquidity, structure, and confluence, and leaving the entry
// decision to the trader. Nothing in this file calls alert() or talks to
// any webhook/backend anymore -- it is purely visual/informational.
//
// What's still here, each independently toggleable:
//   - Standing structure bias (higher-high/higher-low vs lower-high/
//     lower-low), optionally re-sourced from a dedicated "direction"
//     timeframe instead of the chart's own swings.
//   - Higher-timeframe bias (HTF close vs its own EMA).
//   - Market regime (ADX) -- trend vs. chop, informational only, no gate.
//   - Volume strength vs. its own recent average.
//   - SMT divergence against a correlated symbol (default ES).
//   - A 1-minute rejection-candle read.
//   - Equal highs/lows (liquidity pools).
//   - The nearest significant (multi-touch) untested liquidity draw above
//     and below price -- BSL/SSL, classic ICT buy-side/sell-side liquidity,
//     distinct from the routine EQH/EQL match lines above.
//   - Order blocks (last opposing candle before a displacement move).
//   - Every significant fair value gap, flipped to iFVG styling once
//     violated, deleted once reclaimed.
//   - A higher-timeframe FVG zone (the single most recent untested one per
//     direction) -- stays visible while price trades into it instead of
//     vanishing the instant it's tapped, since there's no trigger left to
//     "consume" it.
//   - Premium/discount zone + Fibonacci retracement/equilibrium/OTE band
//     around the active swing range.
//   - Killzone session shading (Asia/London/NY AM/NY PM) + a running
//     average realized range per session.
// All of it feeds a single top-right status HUD. Colors match Polaris's
// dark cyan/gold command-center theme:
//   cyan   #00D4FF  -- structure / tracking
//   gold   #F5C86B  -- attention (liquidity pools, iFVG flips)
//   green  #2FE08A  -- bullish / long bias
//   red    #FF5566  -- bearish / short bias
// ============================================================================

// ---------- inputs ----------
grpScan = "Scanner"
swingStrength = input.int(3, "Swing strength (bars each side)", minval=1, maxval=10, group=grpScan)
maxSwings     = input.int(20, "Max recent swings tracked per side", minval=5, maxval=50, group=grpScan)
showHud       = input.bool(true, "Show status panel (top-right)", group=grpScan)

grpFVG = "Fair Value Gaps"
showAllFvg    = input.bool(true, "Mark every significant FVG on the chart", group=grpFVG)
showIfvg      = input.bool(true, "Flip violated FVGs to iFVG styling", group=grpFVG)
minFvgSizeAtr = input.float(0.3, "Min FVG size to mark (x ATR)", minval=0, step=0.05, group=grpFVG)
maxFvgBoxes   = input.int(15, "Max FVG boxes shown", minval=1, maxval=50, group=grpFVG)

grpOB = "Order Blocks"
showOB       = input.bool(true, "Mark order blocks", group=grpOB)
obBiasFilter = input.bool(true, "Only mark order blocks agreeing with the standing bias", group=grpOB)
dispMult     = input.float(2.0, "Displacement threshold (x ATR)", minval=0.5, step=0.1, group=grpOB)
obLookback   = input.int(3, "Bars back to find the opposing candle", minval=1, maxval=8, group=grpOB)
maxOB        = input.int(12, "Max order blocks shown", minval=1, maxval=40, group=grpOB)

grpEQ = "Equal Highs / Lows"
showEQ   = input.bool(true, "Mark equal highs/lows (liquidity pools)", group=grpEQ)
eqTolPct = input.float(0.01, "Equal tolerance (% of price)", minval=0.01, step=0.01, group=grpEQ)

grpDraws = "Liquidity Draws"
// The nearest untested pool above/below price that multiple swings have
// actually clustered at -- classic ICT buy-side/sell-side liquidity, the
// levels price is most likely being drawn toward -- distinct from the
// routine EQH/EQL dotted match-lines above, which mark every equal-swing
// match regardless of how established it is.
showLiquidityDraws = input.bool(true, "Mark the nearest significant untested liquidity draw above/below price (BSL/SSL)", group=grpDraws)
minDrawTouches      = input.int(3, "Min swings clustered at a level to count as a significant draw", minval=2, maxval=6, group=grpDraws)

grpPD = "Premium / Discount"
showPD = input.bool(false, "Shade premium/discount zone", group=grpPD)

grpFib = "Fibonacci / Equilibrium / OTE"
// Same active swing range as premium/discount above (hiS/loS from the most
// recent tracked swing high/low) -- purely visual/informational. Draws the
// standard retracement ladder (23.6/38.2/61.8/78.6%), calls out 50%
// specifically as equilibrium (same price premium/discount's own eq
// already splits on), and shades the 61.8-78.6% band as the OTE (optimal
// trade entry) zone -- oriented off structureBias so it sits on the actual
// pullback-into-continuation side of the range (measured from the high
// down for a bull bias, from the low up for a bear bias), not just a fixed
// top-of-range/bottom-of-range choice.
showFib = input.bool(true, "Show Fibonacci retracement ladder + equilibrium + OTE zone on the active swing range", group=grpFib)

grpKZ = "Killzones (New York time)"
showKillzones         = input.bool(false, "Shade killzone sessions", group=grpKZ)
showSessionVolatility = input.bool(true, "Track average range per session on the HUD", group=grpKZ)
asiaSession   = input.session("2000-0000", "Asia killzone", group=grpKZ)
londonSession = input.session("0200-0500", "London killzone", group=grpKZ)
nyAmSession   = input.session("0930-1100", "NY AM killzone", group=grpKZ)
nyPmSession   = input.session("1330-1600", "NY PM killzone", group=grpKZ)

grpHTF = "Higher Timeframe Bias"
showHtfBias  = input.bool(true, "Show higher-timeframe bias on the HUD", group=grpHTF)
htfTimeframe = input.timeframe("60", "Higher timeframe", group=grpHTF)
htfEmaLen    = input.int(50, "HTF EMA length", minval=5, group=grpHTF)

grpDirection = "Direction (structure-bias timeframe)"
useMtfDirection    = input.bool(true, "Source structure bias/direction from a dedicated timeframe instead of the chart's own swings", group=grpDirection)
directionTimeframe = input.timeframe("15", "Direction timeframe", group=grpDirection)

grpRegime = "Market Regime"
showRegime   = input.bool(true, "Show trend/chop (ADX) on the HUD", group=grpRegime)
adxLen       = input.int(14, "ADX length", minval=2, group=grpRegime)
adxThreshold = input.float(20, "ADX level considered \"trending\"", minval=5, maxval=50, group=grpRegime)

grpVolume = "Volume"
showVolume = input.bool(true, "Show volume strength vs. its own average on the HUD", group=grpVolume)
volAvgLen  = input.int(20, "Volume average length", minval=5, group=grpVolume)

grpSMT = "SMT Divergence"
showSmt   = input.bool(true, "Show SMT divergence against a correlated symbol on the HUD", group=grpSMT)
smtSymbol = input.symbol("CME_MINI:ES1!", "Correlated symbol to compare swing points against", group=grpSMT)

grpM1 = "1-Minute Read"
showM1 = input.bool(true, "Show a 1-minute rejection-candle read on the HUD", group=grpM1)

grpHtfFvg = "Higher-Timeframe FVG"
showHtfFvg       = input.bool(true, "Draw + show the currently tracked HTF FVG zone", group=grpHtfFvg)
htfFvgTimeframe  = input.timeframe("60", "Timeframe to detect fair value gaps on (e.g. 60 = 1H, 240 = 4H)", group=grpHtfFvg)
minHtfFvgSizeAtr = input.float(1.0, "Min HTF FVG size to track, x chart ATR(14) (0 disables the floor)", minval=0, step=0.1, group=grpHtfFvg)

// ---------- types ----------
type Swing
    int   idx
    float price
    bool  isPool  // true once this swing clusters with another (an equal high/low)
    int   touches // how many swings (including this one) have clustered at this price zone -- starts at 1, rises with each further match. isPool still flips true on the first match (touches=2); a "significant" draw (BSL/SSL below) requires touches >= minDrawTouches, so a level multiple swings have actually clustered at, not just the bare minimum first match.

// ---------- persistent state ----------
var array<Swing> swingHighs = array.new<Swing>()
var array<Swing> swingLows  = array.new<Swing>()

// standing directional filter -- a higher high / higher low sets it
// bullish, a lower high / lower low sets it bearish. Purely informational
// now (the HUD's BIAS/DIR row) -- nothing gates on it anymore.
var string structureBias = na   // "bull" | "bear"

// SMT divergence tracking -- smtPrevHigh/smtPrevLow remember the correlated
// symbol's own last confirmed pivot so the next one can be compared against
// it; smtBearDiv/smtBullDiv are set the moment our own swing confirms (see
// the swing-detection block below).
var float smtPrevHigh = na
var float smtPrevLow  = na
var bool  smtBearDiv  = false
var bool  smtBullDiv  = false

// Direction (15m by default) tracking -- same pattern as the SMT pair
// above: dirPrevHigh/dirPrevLow remember the direction timeframe's own last
// confirmed pivot so the next one can be compared against it, updating
// structureBias directly when useMtfDirection is on.
var float dirPrevHigh = na
var float dirPrevLow  = na

// Higher-timeframe FVG tracking (htfFvgTimeframe, default 1H) -- the single
// most recent untested gap in each direction. "Tested" means price closed
// decisively through it the wrong way without ever rejecting -- at that
// point it stops being a live zone until a new one forms. Boxes are visual
// only (showHtfFvg).
var float htfBullFvgLo = na
var float htfBullFvgHi = na
var bool  htfBullFvgTested = true // true = no active untested zone
var float htfBearFvgLo = na
var float htfBearFvgHi = na
var bool  htfBearFvgTested = true
var box   htfFvgBullBox = na
var box   htfFvgBearBox = na

// ---------- persistent state: confluence markup ----------
var array<box> fvgBoxes     = array.new<box>()
var array<float> fvgBoxLo   = array.new<float>()
var array<float> fvgBoxHi   = array.new<float>()
var array<string> fvgBoxDir = array.new<string>()
var array<bool> fvgBoxDone  = array.new<bool>()
var array<box> obBoxes      = array.new<box>()
var box premiumBox = na
var box discountBox = na
var line eqLine = na

// Nearest significant (multi-touch) untested liquidity draw above/below
// price -- BSL (buy-side liquidity) and SSL (sell-side liquidity), classic
// ICT terms for the levels price is most likely being drawn toward.
// Redrawn from scratch every confirmed bar, same pattern as premium/discount.
var line bslLine = na
var label bslLbl = na
var line sslLine = na
var label sslLbl = na
var float bslTrackedPrice = na
var float sslTrackedPrice = na

// Fibonacci / equilibrium / OTE (showFib) -- redrawn from scratch whenever
// the active swing range changes, same delete-then-recreate pattern as
// premium/discount above.
var line fib236Line = na
var line fib382Line = na
var line fib500Line = na
var line fib618Line = na
var line fib786Line = na
var label fib236Lbl  = na
var label fib382Lbl  = na
var label fib500Lbl  = na
var label fib618Lbl  = na
var label fib786Lbl  = na
var box   oteBox     = na

// ---------- persistent state: per-session volatility ----------
// running average realized range (session high - low) for each killzone,
// folded in the moment a session ends -- not a signal, just an "how much
// does this session actually move" reference.
var string curSession     = na
var float  curSessionHigh = na
var float  curSessionLow  = na
var float  sumRangeAsia   = 0.0
var int    countAsia      = 0
var float  sumRangeLondon = 0.0
var int    countLondon    = 0
var float  sumRangeNyAm   = 0.0
var int    countNyAm      = 0
var float  sumRangeNyPm   = 0.0
var int    countNyPm      = 0

// ---------- swing detection + equal highs/lows ----------
ph = ta.pivothigh(swingStrength, swingStrength)
pl = ta.pivotlow(swingStrength, swingStrength)

// SMT divergence source: pulled from a correlated symbol at the identical
// pivot cadence (same swingStrength, same timeframe), so a confirmed pivot
// here lines up bar-for-bar with a confirmed pivot there -- no separate
// swing-tracking state needed for the other symbol.
smtPh = request.security(smtSymbol, timeframe.period, ta.pivothigh(swingStrength, swingStrength))
smtPl = request.security(smtSymbol, timeframe.period, ta.pivotlow(swingStrength, swingStrength))

// Direction source: same pivot function pulled from a dedicated timeframe (15m by
// default) instead of a correlated symbol -- called unconditionally every bar
// regardless of useMtfDirection (a request.security call gated by an if-block
// trips Pine's CW10003 warning).
dirPh = request.security(syminfo.tickerid, directionTimeframe, ta.pivothigh(swingStrength, swingStrength))
dirPl = request.security(syminfo.tickerid, directionTimeframe, ta.pivotlow(swingStrength, swingStrength))

if not na(ph)
    int newHighIdx = bar_index - swingStrength
    // pool-matching runs unconditionally (it decides which swings count as
    // liquidity pools) -- showEQ only controls whether the match gets drawn.
    bool poolMatch = false
    int matchTouches = 1
    if array.size(swingHighs) > 0
        float tol = ph * eqTolPct / 100
        for i = 0 to array.size(swingHighs) - 1
            Swing s = array.get(swingHighs, i)
            if math.abs(s.price - ph) <= tol
                poolMatch := true
                s.isPool := true
                s.touches := s.touches + 1
                matchTouches := s.touches
                if showEQ
                    line.new(s.idx, s.price, newHighIdx, ph, color=color.new(#F5C86B, 30), style=line.style_dotted, width=1)
                    label.new(newHighIdx, ph, "EQH", style=label.style_label_down, color=color.new(#0B1626, 15), textcolor=#F5C86B, size=size.tiny)
                break
    if array.size(swingHighs) > 0
        Swing prevHigh = array.get(swingHighs, 0)
        if ph > prevHigh.price
            // structureBias only set from the chart's own swings when useMtfDirection
            // is off -- otherwise the dedicated direction-timeframe block below owns it
            if not useMtfDirection
                structureBias := "bull"
            // bearish SMT: we made a higher high, the correlated symbol didn't
            smtBearDiv := not na(smtPh) and not na(smtPrevHigh) and smtPh <= smtPrevHigh
        else if ph < prevHigh.price
            if not useMtfDirection
                structureBias := "bear"
    if not na(smtPh)
        smtPrevHigh := smtPh
    array.unshift(swingHighs, Swing.new(newHighIdx, ph, poolMatch, matchTouches))
    if array.size(swingHighs) > maxSwings
        array.pop(swingHighs)

if not na(pl)
    int newLowIdx = bar_index - swingStrength
    bool poolMatchLow = false
    int matchTouchesLow = 1
    if array.size(swingLows) > 0
        float tol = pl * eqTolPct / 100
        for i = 0 to array.size(swingLows) - 1
            Swing s = array.get(swingLows, i)
            if math.abs(s.price - pl) <= tol
                poolMatchLow := true
                s.isPool := true
                s.touches := s.touches + 1
                matchTouchesLow := s.touches
                if showEQ
                    line.new(s.idx, s.price, newLowIdx, pl, color=color.new(#F5C86B, 30), style=line.style_dotted, width=1)
                    label.new(newLowIdx, pl, "EQL", style=label.style_label_up, color=color.new(#0B1626, 15), textcolor=#F5C86B, size=size.tiny)
                break
    if array.size(swingLows) > 0
        Swing prevLow = array.get(swingLows, 0)
        if pl < prevLow.price
            if not useMtfDirection
                structureBias := "bear"
            // bullish SMT: we made a lower low, the correlated symbol didn't
            smtBullDiv := not na(smtPl) and not na(smtPrevLow) and smtPl >= smtPrevLow
        else if pl > prevLow.price
            if not useMtfDirection
                structureBias := "bull"
    if not na(smtPl)
        smtPrevLow := smtPl
    array.unshift(swingLows, Swing.new(newLowIdx, pl, poolMatchLow, matchTouchesLow))
    if array.size(swingLows) > maxSwings
        array.pop(swingLows)

// direction-timeframe structure bias -- only when useMtfDirection is on. Updates
// independently of the chart's own ph/pl pivots above, since a 15m pivot confirms
// on its own schedule, not bar-for-bar with the chart's 5m swings. Same
// higher-high/higher-low vs lower-high/lower-low logic as the chart-native version,
// just comparing the direction timeframe's own last two confirmed pivots.
if useMtfDirection
    if not na(dirPh)
        if not na(dirPrevHigh)
            structureBias := dirPh > dirPrevHigh ? "bull" : dirPh < dirPrevHigh ? "bear" : structureBias
        dirPrevHigh := dirPh
    if not na(dirPl)
        if not na(dirPrevLow)
            structureBias := dirPl < dirPrevLow ? "bear" : dirPl > dirPrevLow ? "bull" : structureBias
        dirPrevLow := dirPl

// ---------- helpers ----------
// mirrors fvgAt(cs, k, dir) from the original JS scanner -- off is bars back
// from current bar for candle "k"
fvgAtBear(int off) =>
    bool has = low[off + 2] > high[off]
    [has, has ? high[off] : na, has ? low[off + 2] : na]

fvgAtBull(int off) =>
    bool has = high[off + 2] < low[off]
    [has, has ? high[off + 2] : na, has ? low[off] : na]

// nearest untested liquidity pool beyond refPrice in the given direction,
// requiring s.touches >= minDrawTouches -- a level multiple prior swings
// have actually clustered at, not just a bare first equal-high/low match.
// Bull looks in swingHighs above refPrice (BSL, buy-side liquidity above
// price), bear looks in swingLows below refPrice (SSL, sell-side liquidity
// below price). Returns na if no such level exists yet.
findLiquidityDraw(string dir, float refPrice) =>
    float best = na
    if dir == "bull"
        if array.size(swingHighs) > 0
            for i = 0 to array.size(swingHighs) - 1
                Swing s = array.get(swingHighs, i)
                if s.touches >= minDrawTouches and s.price > refPrice
                    if na(best) or s.price < best
                        best := s.price
    else
        if array.size(swingLows) > 0
            for i = 0 to array.size(swingLows) - 1
                Swing s = array.get(swingLows, i)
                if s.touches >= minDrawTouches and s.price < refPrice
                    if na(best) or s.price > best
                        best := s.price
    best

// atrVal, htfBias, adxVal, m1*, and the HTF FVG request.security pulls must
// all be computed unconditionally every bar -- ta.*/request.security calls
// inside a function or if-block that's only invoked conditionally trip
// Pine's CW10003 warning.
atrVal = ta.atr(14)

// higher-timeframe bias -- HTF close above/below its own EMA. Repaint-safe:
// lookahead is off, so this only ever reflects the last *closed* HTF bar.
htfClose = request.security(syminfo.tickerid, htfTimeframe, close, lookahead=barmerge.lookahead_off)
htfEma   = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, htfEmaLen), lookahead=barmerge.lookahead_off)
string htfBias = htfClose > htfEma ? "bull" : htfClose < htfEma ? "bear" : na

// market regime -- ADX below threshold means chop/no clear trend. Purely
// informational (the HUD's ADX row) -- nothing gates on this anymore.
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
bool regimeOk = adxVal >= adxThreshold

// 1-minute read: the most recently confirmed 1m candle's OHLC, pulled
// unconditionally every bar (same CW10003 reasoning as htfClose/htfEma
// above). A long wick relative to the candle's own range is a simple,
// defensible rejection-leg proxy -- informational only, shown on the HUD.
[m1o, m1h, m1l, m1c] = request.security(syminfo.tickerid, "1", [open, high, low, close], lookahead=barmerge.lookahead_off)
float m1Range = m1h - m1l
bool m1RejectionBear = m1Range > 0 and (m1h - math.max(m1o, m1c)) > m1Range * 0.5
bool m1RejectionBull = m1Range > 0 and (math.min(m1o, m1c) - m1l) > m1Range * 0.5

// Higher-timeframe FVG detection -- reuses fvgAtBull/fvgAtBear as-is,
// evaluated on htfFvgTimeframe via request.security exactly the way
// smtPh/smtPl and dirPh/dirPl already evaluate a pure bar-series function
// in another context. lookahead=off means this only ever reflects the last
// *closed* HTF bar, same repaint-safety as htfClose/htfEma/dirPh/dirPl.
[htfFvgBullHasR, htfFvgBullLoR, htfFvgBullHiR] = request.security(syminfo.tickerid, htfFvgTimeframe, fvgAtBull(0), lookahead=barmerge.lookahead_off)
[htfFvgBearHasR, htfFvgBearLoR, htfFvgBearHiR] = request.security(syminfo.tickerid, htfFvgTimeframe, fvgAtBear(0), lookahead=barmerge.lookahead_off)

// declared here (not down by the order-block section it feeds) because
// Pine requires an identifier declared above the code that reads it.
bool isDisplacement = math.abs(close - open) > atrVal * dispMult

// order flow proxy -- Pine has no access to real bid/ask or DOM data, so
// this is bar volume vs its own recent average, not true order flow.
// Informational only, shown on the HUD.
avgVolume = ta.sma(volume, volAvgLen)
float volRatio = avgVolume > 0 ? volume / avgVolume : na

// ---------- killzone sessions ----------
inAsia   = not na(time(timeframe.period, asiaSession, "America/New_York"))
inLondon = not na(time(timeframe.period, londonSession, "America/New_York"))
inNyAm   = not na(time(timeframe.period, nyAmSession, "America/New_York"))
inNyPm   = not na(time(timeframe.period, nyPmSession, "America/New_York"))
bgcolor(showKillzones and (inAsia or inLondon) ? color.new(#00D4FF, 95) : na, title="Asia/London killzone")
bgcolor(showKillzones and (inNyAm or inNyPm) ? color.new(#F5C86B, 95) : na, title="NY killzone")

// ---------- order blocks (last opposing candle before a displacement move) ----------
if showOB and barstate.isconfirmed and isDisplacement
    if close > open and (not obBiasFilter or structureBias != "bear")
        int k = 1
        bool found = false
        while k <= obLookback and not found
            if close[k] < open[k]
                found := true
                box ob = box.new(bar_index - k, top=open[k], right=bar_index + 15, bottom=close[k], border_color=color.new(#2FE08A, 45), bgcolor=color.new(#2FE08A, 88), extend=extend.none, text="OB", text_size=size.tiny, text_color=color.new(#2FE08A, 10))
                array.unshift(obBoxes, ob)
                if array.size(obBoxes) > maxOB
                    box.delete(array.pop(obBoxes))
            k += 1
    else if close < open and (not obBiasFilter or structureBias != "bull")
        int k = 1
        bool found = false
        while k <= obLookback and not found
            if close[k] > open[k]
                found := true
                box ob = box.new(bar_index - k, top=close[k], right=bar_index + 15, bottom=open[k], border_color=color.new(#FF5566, 45), bgcolor=color.new(#FF5566, 88), extend=extend.none, text="OB", text_size=size.tiny, text_color=color.new(#FF5566, 10))
                array.unshift(obBoxes, ob)
                if array.size(obBoxes) > maxOB
                    box.delete(array.pop(obBoxes))
            k += 1

// ---------- fair value gaps everywhere ----------
if showAllFvg and barstate.isconfirmed
    [hasBull, bLo, bHi] = fvgAtBull(0)
    if hasBull and (bHi - bLo) >= minFvgSizeAtr * atrVal
        box fb = box.new(bar_index - 2, top=bHi, right=bar_index + 20, bottom=bLo, border_color=color.new(#2FE08A, 35), bgcolor=color.new(#2FE08A, 88), extend=extend.none, text="FVG", text_size=size.tiny, text_color=color.new(#2FE08A, 10))
        array.unshift(fvgBoxes, fb)
        array.unshift(fvgBoxLo, bLo)
        array.unshift(fvgBoxHi, bHi)
        array.unshift(fvgBoxDir, "bull")
        array.unshift(fvgBoxDone, false)
        if array.size(fvgBoxes) > maxFvgBoxes
            box.delete(array.pop(fvgBoxes))
            array.pop(fvgBoxLo)
            array.pop(fvgBoxHi)
            array.pop(fvgBoxDir)
            array.pop(fvgBoxDone)

    [hasBear, brLo, brHi] = fvgAtBear(0)
    if hasBear and (brHi - brLo) >= minFvgSizeAtr * atrVal
        box fb2 = box.new(bar_index - 2, top=brHi, right=bar_index + 20, bottom=brLo, border_color=color.new(#FF5566, 35), bgcolor=color.new(#FF5566, 88), extend=extend.none, text="FVG", text_size=size.tiny, text_color=color.new(#FF5566, 10))
        array.unshift(fvgBoxes, fb2)
        array.unshift(fvgBoxLo, brLo)
        array.unshift(fvgBoxHi, brHi)
        array.unshift(fvgBoxDir, "bear")
        array.unshift(fvgBoxDone, false)
        if array.size(fvgBoxes) > maxFvgBoxes
            box.delete(array.pop(fvgBoxes))
            array.pop(fvgBoxLo)
            array.pop(fvgBoxHi)
            array.pop(fvgBoxDir)
            array.pop(fvgBoxDone)

    // maintenance pass, newest-to-oldest so removals never skip an entry:
    // un-flipped zones flip to iFVG once violated; already-flipped zones get
    // deleted outright once price reclaims the whole zone back the other way
    // (the iFVG is no longer relevant once that happens)
    if array.size(fvgBoxes) > 0
        for i = array.size(fvgBoxes) - 1 to 0
            bool done = array.get(fvgBoxDone, i)
            string d = array.get(fvgBoxDir, i)
            float zLo = array.get(fvgBoxLo, i)
            float zHi = array.get(fvgBoxHi, i)
            box zb = array.get(fvgBoxes, i)
            if not done
                if showIfvg
                    bool violated = d == "bull" ? close < zLo : close > zHi
                    if violated
                        box.set_border_color(zb, color.new(#F5C86B, 20))
                        box.set_bgcolor(zb, color.new(#F5C86B, 85))
                        box.set_text(zb, "iFVG")
                        box.set_text_color(zb, color.new(#F5C86B, 10))
                        box.set_right(zb, bar_index + 20)
                        array.set(fvgBoxDone, i, true)
            else
                bool reclaimed = d == "bull" ? close > zHi : close < zLo
                if reclaimed
                    box.delete(zb)
                    array.remove(fvgBoxes, i)
                    array.remove(fvgBoxLo, i)
                    array.remove(fvgBoxHi, i)
                    array.remove(fvgBoxDir, i)
                    array.remove(fvgBoxDone, i)

// ---------- liquidity draws (nearest significant untested pool above/below price) ----------
if showLiquidityDraws and barstate.isconfirmed
    float bslPrice = findLiquidityDraw("bull", close)
    float sslPrice = findLiquidityDraw("bear", close)
    bslTrackedPrice := bslPrice
    sslTrackedPrice := sslPrice
    if not na(bslLine)
        line.delete(bslLine)
    if not na(bslLbl)
        label.delete(bslLbl)
    if not na(bslPrice)
        bslLine := line.new(bar_index - 40, bslPrice, bar_index + 10, bslPrice, color=color.new(#F5C86B, 15), style=line.style_dashed, width=2)
        bslLbl := label.new(bar_index + 10, bslPrice, "BSL " + str.tostring(bslPrice, format.mintick), style=label.style_label_left, color=color.new(#0B1626, 10), textcolor=#F5C86B, size=size.small)
    if not na(sslLine)
        line.delete(sslLine)
    if not na(sslLbl)
        label.delete(sslLbl)
    if not na(sslPrice)
        sslLine := line.new(bar_index - 40, sslPrice, bar_index + 10, sslPrice, color=color.new(#F5C86B, 15), style=line.style_dashed, width=2)
        sslLbl := label.new(bar_index + 10, sslPrice, "SSL " + str.tostring(sslPrice, format.mintick), style=label.style_label_left, color=color.new(#0B1626, 10), textcolor=#F5C86B, size=size.small)

// ---------- premium / discount + Fibonacci / equilibrium / OTE ----------
if (showPD or showFib) and barstate.isconfirmed and array.size(swingHighs) > 0 and array.size(swingLows) > 0
    Swing hiS = array.get(swingHighs, 0)
    Swing loS = array.get(swingLows, 0)
    if hiS.price > loS.price
        float eq = (hiS.price + loS.price) / 2
        int leftX = math.min(hiS.idx, loS.idx)
        if showPD
            if not na(premiumBox)
                box.delete(premiumBox)
            if not na(discountBox)
                box.delete(discountBox)
            if not na(eqLine)
                line.delete(eqLine)
            premiumBox := box.new(leftX, top=hiS.price, right=bar_index + 10, bottom=eq, border_color=color.new(#FF5566, 75), bgcolor=color.new(#FF5566, 94), extend=extend.none, text="PREMIUM", text_size=size.tiny, text_color=color.new(#FF5566, 30))
            discountBox := box.new(leftX, top=eq, right=bar_index + 10, bottom=loS.price, border_color=color.new(#2FE08A, 75), bgcolor=color.new(#2FE08A, 94), extend=extend.none, text="DISCOUNT", text_size=size.tiny, text_color=color.new(#2FE08A, 30))
            eqLine := line.new(leftX, eq, bar_index + 10, eq, color=color.new(#F5C86B, 40), style=line.style_dotted, width=1)

        if showFib
            float swingRange = hiS.price - loS.price
            // measured in the direction price would need to retrace for a
            // continuation entry: from the high down for a bull bias, from
            // the low up for a bear bias -- so 61.8/78.6% (the OTE band)
            // always lands on the actual pullback-into-continuation side,
            // not just a fixed top-of-range/bottom-of-range choice. Defaults
            // to low->high (0%=low) when there's no bias yet, same
            // bias-agnostic framing premium/discount already uses.
            bool measureFromHigh = structureBias == "bull"
            float p236 = measureFromHigh ? hiS.price - swingRange * 0.236 : loS.price + swingRange * 0.236
            float p382 = measureFromHigh ? hiS.price - swingRange * 0.382 : loS.price + swingRange * 0.382
            float p500 = eq
            float p618 = measureFromHigh ? hiS.price - swingRange * 0.618 : loS.price + swingRange * 0.618
            float p786 = measureFromHigh ? hiS.price - swingRange * 0.786 : loS.price + swingRange * 0.786
            if not na(fib236Line)
                line.delete(fib236Line)
            if not na(fib382Line)
                line.delete(fib382Line)
            if not na(fib500Line)
                line.delete(fib500Line)
            if not na(fib618Line)
                line.delete(fib618Line)
            if not na(fib786Line)
                line.delete(fib786Line)
            if not na(fib236Lbl)
                label.delete(fib236Lbl)
            if not na(fib382Lbl)
                label.delete(fib382Lbl)
            if not na(fib500Lbl)
                label.delete(fib500Lbl)
            if not na(fib618Lbl)
                label.delete(fib618Lbl)
            if not na(fib786Lbl)
                label.delete(fib786Lbl)
            if not na(oteBox)
                box.delete(oteBox)
            fib236Line := line.new(leftX, p236, bar_index + 10, p236, color=color.new(#6E93AD, 55), style=line.style_dotted, width=1)
            fib382Line := line.new(leftX, p382, bar_index + 10, p382, color=color.new(#6E93AD, 55), style=line.style_dotted, width=1)
            fib500Line := line.new(leftX, p500, bar_index + 10, p500, color=color.new(#F5C86B, 40), style=line.style_dashed, width=1)
            fib618Line := line.new(leftX, p618, bar_index + 10, p618, color=color.new(#00D4FF, 45), style=line.style_dotted, width=1)
            fib786Line := line.new(leftX, p786, bar_index + 10, p786, color=color.new(#00D4FF, 45), style=line.style_dotted, width=1)
            fib236Lbl := label.new(bar_index + 10, p236, "23.6", style=label.style_label_left, color=color.new(#0B1626, 20), textcolor=#6E93AD, size=size.tiny)
            fib382Lbl := label.new(bar_index + 10, p382, "38.2", style=label.style_label_left, color=color.new(#0B1626, 20), textcolor=#6E93AD, size=size.tiny)
            fib500Lbl := label.new(bar_index + 10, p500, "EQ 50", style=label.style_label_left, color=color.new(#0B1626, 20), textcolor=#F5C86B, size=size.tiny)
            fib618Lbl := label.new(bar_index + 10, p618, "61.8", style=label.style_label_left, color=color.new(#0B1626, 20), textcolor=#00D4FF, size=size.tiny)
            fib786Lbl := label.new(bar_index + 10, p786, "78.6 OTE", style=label.style_label_left, color=color.new(#0B1626, 20), textcolor=#00D4FF, size=size.tiny)
            float oteTop = math.max(p618, p786)
            float oteBottom = math.min(p618, p786)
            oteBox := box.new(leftX, top=oteTop, right=bar_index + 10, bottom=oteBottom, border_color=color.new(#00D4FF, 40), bgcolor=color.new(#00D4FF, 88), extend=extend.none, text="OTE", text_size=size.tiny, text_color=color.new(#00D4FF, 15))

// ---------- per-session volatility tracking ----------
// runs every confirmed bar regardless of showKillzones -- this is a pure
// readout, not a gate. On every session change, folds the just-completed
// session's realized range into that session's running average; while
// still inside a session, extends the running high/low.
if showSessionVolatility and barstate.isconfirmed
    string nowSession = inAsia ? "asia" : inLondon ? "london" : inNyAm ? "nyam" : inNyPm ? "nypm" : na
    if nowSession != curSession
        if not na(curSession) and not na(curSessionHigh) and not na(curSessionLow)
            float completedRange = curSessionHigh - curSessionLow
            if curSession == "asia"
                sumRangeAsia := sumRangeAsia + completedRange
                countAsia := countAsia + 1
            else if curSession == "london"
                sumRangeLondon := sumRangeLondon + completedRange
                countLondon := countLondon + 1
            else if curSession == "nyam"
                sumRangeNyAm := sumRangeNyAm + completedRange
                countNyAm := countNyAm + 1
            else if curSession == "nypm"
                sumRangeNyPm := sumRangeNyPm + completedRange
                countNyPm := countNyPm + 1
        curSession := nowSession
        curSessionHigh := na(nowSession) ? na : high
        curSessionLow := na(nowSession) ? na : low
    else if not na(nowSession)
        curSessionHigh := math.max(curSessionHigh, high)
        curSessionLow := math.min(curSessionLow, low)

// ---------- higher-timeframe FVG tracking ----------
// runs every confirmed bar: (1) adopt a freshly detected HTF gap as the new
// tracked zone, size-filtered by minHtfFvgSizeAtr x the chart's own ATR;
// (2) drop the tracked zone if price has since closed decisively through it
// the wrong way without ever rejecting (a failed/invalidated gap shouldn't
// linger indefinitely); (3) keep the visual box in sync. Purely visual now
// -- there's no trigger left to "consume" the zone the instant price wicks
// into it, so it stays drawn while price is actually trading into it.
if barstate.isconfirmed
    if htfFvgBullHasR and (htfFvgBullHiR - htfFvgBullLoR) >= minHtfFvgSizeAtr * atrVal and (na(htfBullFvgLo) or htfFvgBullLoR != htfBullFvgLo or htfFvgBullHiR != htfBullFvgHi)
        htfBullFvgLo := htfFvgBullLoR
        htfBullFvgHi := htfFvgBullHiR
        htfBullFvgTested := false
        if not na(htfFvgBullBox)
            box.delete(htfFvgBullBox)
        htfFvgBullBox := showHtfFvg ? box.new(bar_index - 50, top=htfBullFvgHi, right=bar_index + 10, bottom=htfBullFvgLo, border_color=color.new(#00D4FF, 25), bgcolor=color.new(#00D4FF, 90), extend=extend.right, text="HTF FVG", text_size=size.tiny, text_color=color.new(#00D4FF, 10)) : box(na)
    if not htfBullFvgTested and not na(htfBullFvgLo) and close < htfBullFvgLo
        htfBullFvgTested := true // failed -- closed back through the bottom without ever rejecting from the top
        if not na(htfFvgBullBox)
            box.delete(htfFvgBullBox)
            htfFvgBullBox := box(na)

    if htfFvgBearHasR and (htfFvgBearHiR - htfFvgBearLoR) >= minHtfFvgSizeAtr * atrVal and (na(htfBearFvgLo) or htfFvgBearLoR != htfBearFvgLo or htfFvgBearHiR != htfBearFvgHi)
        htfBearFvgLo := htfFvgBearLoR
        htfBearFvgHi := htfFvgBearHiR
        htfBearFvgTested := false
        if not na(htfFvgBearBox)
            box.delete(htfFvgBearBox)
        htfFvgBearBox := showHtfFvg ? box.new(bar_index - 50, top=htfBearFvgHi, right=bar_index + 10, bottom=htfBearFvgLo, border_color=color.new(#00D4FF, 25), bgcolor=color.new(#00D4FF, 90), extend=extend.right, text="HTF FVG", text_size=size.tiny, text_color=color.new(#00D4FF, 10)) : box(na)
    if not htfBearFvgTested and not na(htfBearFvgLo) and close > htfBearFvgHi
        htfBearFvgTested := true // failed -- closed back through the top without ever rejecting from the bottom
        if not na(htfFvgBearBox)
            box.delete(htfFvgBearBox)
            htfFvgBearBox := box(na)

// ---------- status HUD (top-right) ----------
var table hud = table.new(position=position.top_right, columns=2, rows=11, bgcolor=color.new(#0B1626, 8), border_color=color.new(#00D4FF, 45), border_width=1, frame_color=color.new(#00D4FF, 45), frame_width=1)

if showHud and barstate.islast
    // "BIAS" row doubles as the direction row -- structureBias IS the direction
    // reading once useMtfDirection is on, so this is a single row with a label
    // that names its actual source, not two rows showing the same value.
    string biasLabel = useMtfDirection ? "DIR " + directionTimeframe : "BIAS"
    table.cell(hud, 0, 0, "◆ POLARIS", text_color=#F5C86B, text_size=size.small, text_halign=text.align_left)
    table.cell(hud, 1, 0, "MAP", text_color=#F5C86B, text_size=size.small, text_halign=text.align_right)
    table.cell(hud, 0, 1, biasLabel, text_color=#6E93AD, text_size=size.tiny, text_halign=text.align_left)
    table.cell(hud, 1, 1, na(structureBias) ? "--" : (structureBias == "bull" ? "▲ LONG" : "▼ SHORT"), text_color=na(structureBias) ? #6E93AD : (structureBias == "bull" ? #2FE08A : #FF5566), text_size=size.small, text_halign=text.align_right)
    if showHtfBias
        table.cell(hud, 0, 2, "HTF " + htfTimeframe, text_color=#6E93AD, text_size=size.tiny, text_halign=text.align_left)
        table.cell(hud, 1, 2, na(htfBias) ? "--" : (htfBias == "bull" ? "▲ LONG" : "▼ SHORT"), text_color=na(htfBias) ? #6E93AD : (htfBias == "bull" ? #2FE08A : #FF5566), text_size=size.small, text_halign=text.align_right)
    if showRegime
        table.cell(hud, 0, 3, "ADX", text_color=#6E93AD, text_size=size.tiny, text_halign=text.align_left)
        table.cell(hud, 1, 3, str.tostring(adxVal, "#.#") + (regimeOk ? " TREND" : " CHOP"), text_color=regimeOk ? #DDF3FF : #6E93AD, text_size=size.small, text_halign=text.align_right)
    string sessionName = inAsia ? "ASIA" : inLondon ? "LONDON" : inNyAm ? "NY AM" : inNyPm ? "NY PM" : "--"
    float sessionAvg = inAsia ? (countAsia > 0 ? sumRangeAsia / countAsia : na) : inLondon ? (countLondon > 0 ? sumRangeLondon / countLondon : na) : inNyAm ? (countNyAm > 0 ? sumRangeNyAm / countNyAm : na) : inNyPm ? (countNyPm > 0 ? sumRangeNyPm / countNyPm : na) : na
    string sessionTxt = sessionName == "--" ? "--" : sessionName + (na(sessionAvg) ? "" : " · avg " + str.tostring(sessionAvg, format.mintick))
    table.cell(hud, 0, 4, "SESSION", text_color=#6E93AD, text_size=size.tiny, text_halign=text.align_left)
    table.cell(hud, 1, 4, sessionTxt, text_color=sessionName == "--" ? #6E93AD : #DDF3FF, text_size=size.small, text_halign=text.align_right)
    if showVolume
        table.cell(hud, 0, 5, "VOL", text_color=#6E93AD, text_size=size.tiny, text_halign=text.align_left)
        table.cell(hud, 1, 5, na(volRatio) ? "--" : str.tostring(volRatio, "#.##") + "x avg", text_color=na(volRatio) ? #6E93AD : (volRatio >= 1.2 ? #2FE08A : #DDF3FF), text_size=size.small, text_halign=text.align_right)
    if showSmt
        string smtTxt = smtBearDiv ? "BEAR DIV" : smtBullDiv ? "BULL DIV" : "--"
        table.cell(hud, 0, 6, "SMT", text_color=#6E93AD, text_size=size.tiny, text_halign=text.align_left)
        table.cell(hud, 1, 6, smtTxt, text_color=smtTxt == "--" ? #6E93AD : #F5C86B, text_size=size.small, text_halign=text.align_right)
    if showM1
        string m1Txt = m1RejectionBear ? "BEAR REJ" : m1RejectionBull ? "BULL REJ" : "--"
        table.cell(hud, 0, 7, "M1", text_color=#6E93AD, text_size=size.tiny, text_halign=text.align_left)
        table.cell(hud, 1, 7, m1Txt, text_color=m1Txt == "--" ? #6E93AD : #F5C86B, text_size=size.small, text_halign=text.align_right)
    if showLiquidityDraws
        table.cell(hud, 0, 8, "BSL", text_color=#6E93AD, text_size=size.tiny, text_halign=text.align_left)
        table.cell(hud, 1, 8, na(bslTrackedPrice) ? "--" : str.tostring(bslTrackedPrice, format.mintick), text_color=na(bslTrackedPrice) ? #6E93AD : #F5C86B, text_size=size.small, text_halign=text.align_right)
        table.cell(hud, 0, 9, "SSL", text_color=#6E93AD, text_size=size.tiny, text_halign=text.align_left)
        table.cell(hud, 1, 9, na(sslTrackedPrice) ? "--" : str.tostring(sslTrackedPrice, format.mintick), text_color=na(sslTrackedPrice) ? #6E93AD : #F5C86B, text_size=size.small, text_halign=text.align_right)
    if showHtfFvg
        string htfFvgTxt = not htfBullFvgTested and not na(htfBullFvgLo) ? "BULL @ " + str.tostring(htfBullFvgHi, format.mintick) : not htfBearFvgTested and not na(htfBearFvgLo) ? "BEAR @ " + str.tostring(htfBearFvgLo, format.mintick) : "--"
        table.cell(hud, 0, 10, "HTF FVG " + htfFvgTimeframe, text_color=#6E93AD, text_size=size.tiny, text_halign=text.align_left)
        table.cell(hud, 1, 10, htfFvgTxt, text_color=htfFvgTxt == "--" ? #6E93AD : #00D4FF, text_size=size.small, text_halign=text.align_right)
